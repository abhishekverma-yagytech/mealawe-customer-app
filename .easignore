# IMPORTANT: once this file exists, EAS CLI stops respecting .gitignore
# entirely for the build archive (it does not merge the two) — see
# https://expo.fyi/eas-build-archive. Everything below therefore has to
# mirror .gitignore by hand; keep the two in sync when either changes.
# (This is also why the archive ballooned to 271MB despite .gitignore
# excluding most of it — .worktrees/ and .expo/ were silently no longer
# excluded once this file was first added.)

# dependencies (also excluded by EAS's default packaging regardless — kept
# explicit here for clarity/defense-in-depth)
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# Signing / credentials — never let these reach a cloud build worker
*.jks
*.bak.jks
*.p12
*.key
*.mobileprovision
play-store-credentials.json
*service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# git worktrees — each is a full parallel checkout (can easily be multiple
# GB) and never needed by a cloud build
.worktrees/

# brainstorming visual companion
.superpowers/

# repomix (regenerate with `npx repomix`)
repomix-output.*

# Not needed by EAS cloud builds — trims upload size (see docs/BUILD-OPTIMIZATION-PLAN.md #3)
docs/*.pdf
docs/*.xlsx
docs/*.html
Hero-Animation-Options.pdf

# Locally-generated native folders (gitignored) — if these exist on disk when
# `eas build` runs, EAS misdetects this as a bare-workflow project, which
# breaks runtimeVersion's "appVersion" policy (see 2026-08-25 build failure).
# Always let EAS run its own prebuild instead.
android/
ios/
