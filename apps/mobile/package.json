  "scripts": {
    "// setup": "────────────────────────────────",
    "postinstall": "echo postinstall handled at monorepo root",
    "// patch:jsi": "Local iOS builds make expo-modules-jsi write build products (Products/, .DerivedData/, .generated/, .swiftpm/) into its own node_modules folder. A bare `patch-package expo-modules-jsi` sweeps those in as thousands of lines of stale build-artifact diffs alongside the real source fix, which then get force-reapplied on every install (incl. EAS Build) and crash the app at launch with a stale/mismatched binary. Happened twice already — always regenerate with this script, never the bare command.",
    "patch:jsi": "patch-package expo-modules-jsi --exclude 'Products/|\\.DerivedData/|\\.generated/|\\.swiftpm/'",
    "// dev server": "────────────────────────────────",
    "start": "expo start --dev-client",
    "start:local": "cross-env EXPO_PUBLIC_ENV=local expo start",
    "start:staging": "cross-env EXPO_PUBLIC_ENV=staging expo start",
    "start:prod": "cross-env EXPO_PUBLIC_ENV=production expo start",
    "start:clear": "expo start -c",
    "// android (local run — scoped to one ABI, see docs/BUILD-OPTIMIZATION-PLAN.md #2)": "────────────────────────────────",
    "start:mcp": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "cross-env ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:local": "cross-env EXPO_PUBLIC_ENV=local ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:staging": "cross-env EXPO_PUBLIC_ENV=staging ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:prod": "cross-env EXPO_PUBLIC_ENV=production ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "// ios (local run)": "────────────────────────────────",
    "ios": "expo run:ios",
    "ios:local": "cross-env EXPO_PUBLIC_ENV=local expo run:ios",
    "ios:staging": "cross-env EXPO_PUBLIC_ENV=staging expo run:ios",
    "ios:prod": "cross-env EXPO_PUBLIC_ENV=production expo run:ios",
    "// prebuild": "────────────────────────────────",
    "prebuild": "expo prebuild --clean",
    "// eas build - android": "────────────────────────────────",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:staging:android": "npx eas-cli build --profile staging --platform android",
    "build:staging-preview:android": "npx eas-cli build --profile staging-preview --platform android",
    "build:prod:android": "npx eas-cli build --profile production --platform android",
    "build:prod-preview:android": "npx eas-cli build --profile production-preview --platform android",
    "// eas build - ios": "────────────────────────────────",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios",
    "build:staging:ios": "npx eas-cli build --profile staging --platform ios",
    "build:staging-preview:ios": "npx eas-cli build --profile staging-preview --platform ios",
    "build:prod:ios": "npx eas-cli build --profile production --platform ios",
    "build:prod-preview:ios": "npx eas-cli build --profile production-preview --platform ios",
    "// eas build - both platforms": "────────────────────────────────",
    "build:staging:all": "npx eas-cli build --profile staging --platform all",
    "build:staging-preview:all": "npx eas-cli build --profile staging-preview --platform all",
    "build:prod:all": "npx eas-cli build --profile production --platform all",
    "build:prod-preview:all": "npx eas-cli build --profile production-preview --platform all",
    "// eas submit - android": "────────────────────────────────",
    "submit:android:internal": "npx eas-cli submit --profile internal --platform android --latest",
    "submit:android:alpha": "npx eas-cli submit --profile alpha --platform android --latest",
    "submit:android:beta": "npx eas-cli submit --profile beta --platform android --latest",
    "submit:android:production": "npx eas-cli submit --profile production --platform android --latest",
    "// eas submit - ios (TestFlight internal group; external groups are manual in App Store Connect)": "────────────────────────────────",
    "submit:ios:internal": "npx eas-cli submit --profile internal --platform ios --latest",
    "submit:ios:production": "npx eas-cli submit --profile production --platform ios --latest",
    "// eas workflows (manual only — no GitHub trigger, see .eas/workflows/)": "────────────────────────────────",
    "workflow:build": "npx eas-cli workflow:run .eas/workflows/build.yml",
    "workflow:deploy": "npx eas-cli workflow:run .eas/workflows/deploy.yml",
    "// eas update (OTA) — see docs/CI-CD-RELEASE-GUIDE.md §2.6 for when to use this instead of a build": "────────────────────────────────",
    "update:staging": "npx eas-cli update --branch staging --environment preview",
    "update:production": "npx eas-cli update --branch production --environment production",
    "// lint & typecheck": "────────────────────────────────",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "// e2e (maestro)": "────────────────────────────────",
    "e2e:maestro": "maestro test .maestro/flows",
    "e2e:maestro:studio": "maestro studio",
    "// misc": "────────────────────────────────",
    "reset-project": "node ./scripts/reset-project.js",
    "clean:native-cache": "rimraf --glob \"node_modules/**/android/build\" \"node_modules/**/android/.cxx\"",
    "doctor": "expo-doctor"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@eabdullazyanov/react-native-sms-user-consent",
          "@notifee/react-native",
          "hyper-sdk-react"
        ]
      }
    }
  }
}
