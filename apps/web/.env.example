# Copy to .env.local — names only; get values from the team.
NEXT_PUBLIC_ENV=staging
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Hero lottie slides are configured per device OS in the dashboard; web borrows one (ios | android).
NEXT_PUBLIC_HERO_PLATFORM=ios

# Extra image hosts to optimize via next/image (comma-separated, e.g. a CloudFront/S3 host). The API host is always
# included. Images from any other host still load, just unoptimized. Changing this needs a rebuild.
NEXT_PUBLIC_IMAGE_HOSTS=
